# ═════════════════════════════════════════════════════════════════
# ACE SCHOLAR — Environment Variables (template)
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.
# ═════════════════════════════════════════════════════════════════

# ── Supabase (Required) ─────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# ── Admin (Required) ────────────────────────────────────────────
ADMIN_EMAIL="you@example.com"

# ── Server ──────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN="http://localhost:5173"

# ── Payment Configuration ───────────────────────────────────────
# These are served via GET /api/payments/config
CBE_ACCOUNT_NUMBER=
CBE_ACCOUNT_NAME=

TELEBIRR_NUMBER=
TELEBIRR_NAME=

BOA_ACCOUNT_NUMBER=
BOA_ACCOUNT_NAME=

# USDT — supported across multiple networks
USDT_ERC20_ADDRESS=
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=

# Bitcoin (single network)
BTC_ADDRESS=
CRYPTO_DISCOUNT_PERCENT=5

# Card — manual transfer (Bybit card)
CARD_NAME=
BYBIT_CARD_NUMBER=
BYBIT_CARD_HOLDER_NAME=

# ── Contact & Site Info ─────────────────────────────────────────
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_DESK_EMAIL=
VITE_OFFICE_LOCATION=

# ── Admin Commission ────────────────────────────────────────────
ADMIN_CUT_PERCENT=10

# ── Exchange Rates (client-side, VITE_ prefix required) ─────────
VITE_EXCHANGE_RATES='{"ETB":{"symbol":"Br","rate":120},"GBP":{"symbol":"£","rate":0.79},"EUR":{"symbol":"€","rate":0.92},"CAD":{"symbol":"C$","rate":1.36},"AUD":{"symbol":"A$","rate":1.51},"AED":{"symbol":"AED ","rate":3.67},"SAR":{"symbol":"SR ","rate":3.75}}'

# ── Base Order Minimums ─────────────────────────────────────────
VITE_BASE_PRICE_USD=15
VITE_BASE_PRICE_ETB=500

# ── Pricing Ranges (USD, shown to international users) ──────────
# Format: "MIN–MAX" or "MIN–MAX+" for open-ended tiers
VITE_PRICE_WRITING_BASIC="$20–$40"
VITE_PRICE_WRITING_STANDARD="$40–$80"
VITE_PRICE_WRITING_PREMIUM="$80–$200+"
VITE_PRICE_CODING_BASIC="$20–$40"
VITE_PRICE_CODING_STANDARD="$50–$100"
VITE_PRICE_CODING_PREMIUM="$100–$300+"
VITE_PRICE_ENGINEERING_BASIC="$20–$40"
VITE_PRICE_ENGINEERING_STANDARD="$50–$100"
VITE_PRICE_ENGINEERING_PREMIUM="$100–$250+"
VITE_PRICE_DATA_BASIC="$20–$35"
VITE_PRICE_DATA_STANDARD="$40–$80"
VITE_PRICE_DATA_PREMIUM="$80–$200+"
VITE_PRICE_STEM_BASIC="$15–$30"
VITE_PRICE_STEM_STANDARD="$30–$60"
VITE_PRICE_STEM_PREMIUM="$60–$120+"

# ── Pricing Ranges for Ethiopian Users (ETB / Br) ───────────────
VITE_PRICE_ETB_WRITING_BASIC="500–1,500 Br"
VITE_PRICE_ETB_WRITING_STANDARD="1,500–3,000 Br"
VITE_PRICE_ETB_WRITING_PREMIUM="3,000–8,000+ Br"
VITE_PRICE_ETB_CODING_BASIC="500–1,500 Br"
VITE_PRICE_ETB_CODING_STANDARD="2,000–4,000 Br"
VITE_PRICE_ETB_CODING_PREMIUM="4,000–12,000+ Br"
VITE_PRICE_ETB_ENGINEERING_BASIC="500–1,500 Br"
VITE_PRICE_ETB_ENGINEERING_STANDARD="2,000–4,000 Br"
VITE_PRICE_ETB_ENGINEERING_PREMIUM="4,000–10,000+ Br"
VITE_PRICE_ETB_DATA_BASIC="500–1,200 Br"
VITE_PRICE_ETB_DATA_STANDARD="1,500–3,000 Br"
VITE_PRICE_ETB_DATA_PREMIUM="3,000–8,000+ Br"
VITE_PRICE_ETB_STEM_BASIC="300–1,000 Br"
VITE_PRICE_ETB_STEM_STANDARD="1,000–2,500 Br"
VITE_PRICE_ETB_STEM_PREMIUM="2,500–5,000+ Br"

# ── Marketing Stats (shown on landing page) ─────────────────────
VITE_STAT_PROJECTS=2500
VITE_STAT_DELIVERY=98
VITE_STAT_RATING=49
VITE_STAT_COUNTRIES=50