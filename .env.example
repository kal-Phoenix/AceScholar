# ─────────────────────────────────────────────────────────────────────────────
# ACE SCHOLAR — Environment Variables (copy to .env and fill in values)
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Admin (Required) ─────────────────────────────────────────────────────────
ADMIN_EMAIL="you@example.com"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN="http://localhost:5173"

# ── Payment Configuration (Optional) ─────────────────────────────────────────
CBE_ACCOUNT_NUMBER=""
CBE_ACCOUNT_NAME=""
TELEBIRR_NUMBER=""
TELEBIRR_NAME=""
BOA_ACCOUNT_NUMBER=""
BOA_ACCOUNT_NAME=""

# Crypto wallets
USDT_ERC20_ADDRESS=""
USDT_TRC20_ADDRESS=""
USDT_BEP20_ADDRESS=""
BTC_ADDRESS=""
CRYPTO_DISCOUNT_PERCENT="5"

# Card (manual transfer)
CARD_NAME="Credit / Debit Card"
BYBIT_CARD_NUMBER=""
BYBIT_CARD_HOLDER_NAME=""
