{
  "name": "acescholar",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.0.0-beta.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.4"
  }
}
